# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://bloguser:blogpass@localhost:5432/blogdb

# ─────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─────────────────────────────────────────────────────────────
# Object Storage S3 or Local MinIO
# ─────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
BUCKET_NAME=blog-bucket
REGION_NAME=us-east-1

# ─────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────
POSTGRES_DB=blogdb
POSTGRES_USER=bloguser
POSTGRES_PASSWORD=blogpass

# ─────────────────────────────────────────────────────────────
# MinIO
# ─────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ─────────────────────────────────────────────────────────────
# pgAdmin
# ─────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@blog.local
PGADMIN_PASSWORD=admin

# ─────────────────────────────────────────────────────────────
# Jenkins email notifications
# ─────────────────────────────────────────────────────────────
JENKINS_URL=http://localhost:8080/
JENKINS_ADMIN_EMAIL=jenkins@blog.local
EMAIL_RECIPIENTS=felipe.m@ges.inatel.br
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=jenkins@blog.local
SMTP_USE_SSL=false
SMTP_USE_TLS=true

# ─────────────────────────────────────────────────────────────
# Jenkins Docker Hub credentials
# ─────────────────────────────────────────────────────────────
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_TOKEN=your-dockerhub-access-token
